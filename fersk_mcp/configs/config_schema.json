{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/fersk-config.schema.json",
  "title": "Fersk MCP Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "codex",
    "lark",
    "mcp"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "runtime": {},
    "storage": {},
    "messaging": {},
    "codex": {
      "type": "object",
      "required": [
        "watchdog"
      ],
      "properties": {
        "watchdog": {
          "type": "object",
          "required": [
            "cardRequestTimeoutSeconds"
          ],
          "properties": {
            "cardRequestTimeoutSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      }
    },
    "lark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credentials",
        "upload"
      ],
      "properties": {
        "credentials": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "appIdEnv",
            "appSecretEnv"
          ],
          "properties": {
            "appIdEnv": {
              "$ref": "#/$defs/envName"
            },
            "appSecretEnv": {
              "$ref": "#/$defs/envName"
            },
            "robotNameEnv": {},
            "robotOpenIdEnv": {}
          }
        },
        "reaction": {},
        "upload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nativeFileTypes",
            "fallbackFileType"
          ],
          "properties": {
            "nativeFileTypes": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]+$"
              }
            },
            "fallbackFileType": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "resources": {},
    "audio": {},
    "logging": {},
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "version",
        "transport",
        "host",
        "port",
        "path",
        "logLevel"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "transport": {
          "enum": [
            "streamable-http"
          ]
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "logLevel": {
          "$ref": "#/$defs/logLevel"
        },
        "imageModel": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "apiKeyEnv",
            "baseUrl",
            "model"
          ],
          "properties": {
            "apiKeyEnv": {
              "type": "string",
              "minLength": 1
            },
            "baseUrl": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "videoModel": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "apiKeyEnv",
            "baseUrl",
            "model"
          ],
          "properties": {
            "apiKeyEnv": {
              "type": "string",
              "minLength": 1
            },
            "baseUrl": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "messages": {}
  },
  "$defs": {
    "envName": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "logLevel": {
      "enum": [
        "CRITICAL",
        "ERROR",
        "WARNING",
        "INFO",
        "DEBUG",
        "NOTSET"
      ]
    }
  }
}
