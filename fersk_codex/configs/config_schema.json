{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/fersk-config.schema.json",
  "title": "Fersk Codex Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runtime",
    "storage",
    "messaging",
    "codex",
    "lark",
    "resources",
    "audio",
    "logging",
    "mcp",
    "messages"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timezoneOffsetHours"
      ],
      "properties": {
        "timezoneOffsetHours": {
          "type": "number",
          "minimum": -12,
          "maximum": 14
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaceRoot",
        "inboundSubdirectory",
        "databasePath",
        "runLogPath"
      ],
      "properties": {
        "runLogPath": {
          "description": "运行日志目录，按配置时区写入 YYYY-MM-DD_logs.jsonl",
          "type": "string",
          "minLength": 1
        },
        "workspaceRoot": {
          "type": "string",
          "minLength": 1
        },
        "inboundSubdirectory": {
          "type": "string",
          "minLength": 1
        },
        "databasePath": {
          "type": "string",
          "minLength": 1
        },
        "logdatabasePath": {
          "type": "string",
          "pattern": "\\.sqlite$"
        },
        "tokenUsagePath": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "messaging": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bufferWindowSeconds",
        "historyPageSize",
        "recallCacheMaxEntries",
        "directTypes",
        "bufferedTypes",
        "supportedTypes",
        "newThreadCommand",
        "stopThreadCommand"
      ],
      "properties": {
        "bufferWindowSeconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 300
        },
        "historyPageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "recallCacheMaxEntries": {
          "type": "integer",
          "minimum": 1
        },
        "directTypes": {
          "$ref": "#/$defs/messageTypes"
        },
        "bufferedTypes": {
          "$ref": "#/$defs/messageTypes"
        },
        "supportedTypes": {
          "$ref": "#/$defs/messageTypes"
        },
        "newThreadCommand": {
          "type": "string",
          "pattern": "^/",
          "minLength": 2
        },
        "stopThreadCommand": {
          "type": "string",
          "pattern": "^/",
          "minLength": 2
        }
      }
    },
    "codex": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sandbox",
        "models",
        "retry",
        "watchdog"
      ],
      "properties": {
        "watchdog": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxRunSeconds",
            "startupTimeoutSeconds",
            "idleTimeoutSeconds",
            "checkIntervalSeconds",
            "interruptGraceSeconds",
            "cleanupTimeoutSeconds",
            "cardRequestTimeoutSeconds"
          ],
          "properties": {
            "maxRunSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "startupTimeoutSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "idleTimeoutSeconds": {
              "type": "number",
              "minimum": 0
            },
            "checkIntervalSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "interruptGraceSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "cleanupTimeoutSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "cardRequestTimeoutSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "sandbox": {
          "enum": [
            "read-only",
            "workspace-write",
            "danger-full-access"
          ]
        },
        "models": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "image",
            "multimodal"
          ],
          "properties": {
            "text": {
              "$ref": "#/$defs/modelRoute"
            },
            "multimodal": {
              "$ref": "#/$defs/modelRoute"
            },
            "image": {
              "$ref": "#/$defs/modelRoute"
            },
            "file": {
              "$ref": "#/$defs/modelRoute"
            }
          }
        },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxAttempts",
            "initialDelaySeconds",
            "maxDelaySeconds",
            "jitterRatio",
            "backoffMultiplier"
          ],
          "properties": {
            "maxAttempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "initialDelaySeconds": {
              "type": "number",
              "minimum": 0
            },
            "maxDelaySeconds": {
              "type": "number",
              "minimum": 0
            },
            "jitterRatio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "backoffMultiplier": {
              "type": "number",
              "minimum": 1
            }
          }
        }
      }
    },
    "lark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credentials",
        "reaction",
        "upload"
      ],
      "properties": {
        "credentials": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "appIdEnv",
            "appSecretEnv"
          ],
          "anyOf": [
            { "required": ["robotOpenIdEnv"] },
            { "required": ["robotNameEnv"] }
          ],
          "properties": {
            "appIdEnv": {
              "$ref": "#/$defs/envName"
            },
            "appSecretEnv": {
              "$ref": "#/$defs/envName"
            },
            "robotNameEnv": {
              "$ref": "#/$defs/envName"
            },
            "robotOpenIdEnv": {
              "$ref": "#/$defs/envName"
            }
          }
        },
        "reaction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "processingEmoji"
          ],
          "properties": {
            "processingEmoji": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "upload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nativeFileTypes",
            "fallbackFileType",
            "imageType"
          ],
          "properties": {
            "nativeFileTypes": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]+$"
              }
            },
            "fallbackFileType": {
              "type": "string",
              "minLength": 1
            },
            "imageType": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acceptedExtensions",
        "fileName"
      ],
      "properties": {
        "acceptedExtensions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "image",
            "document",
            "audio"
          ],
          "properties": {
            "image": {
              "$ref": "#/$defs/extensions"
            },
            "document": {
              "$ref": "#/$defs/extensions"
            },
            "audio": {
              "$ref": "#/$defs/extensions"
            }
          }
        },
        "fileName": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "timestampFormat",
            "fallbackStem"
          ],
          "properties": {
            "timestampFormat": {
              "type": "string",
              "minLength": 1
            },
            "fallbackStem": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tools",
        "limits",
        "output",
        "asr"
      ],
      "properties": {
        "tools": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ffmpeg",
            "ffprobe"
          ],
          "properties": {
            "ffmpeg": {
              "type": "string",
              "minLength": 1
            },
            "ffprobe": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxBytes",
            "maxDurationSeconds",
            "targetBytes",
            "minimumSegmentSeconds",
            "conversionTimeoutSeconds"
          ],
          "properties": {
            "maxBytes": {
              "type": "integer",
              "minimum": 1
            },
            "maxDurationSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "targetBytes": {
              "type": "integer",
              "minimum": 1
            },
            "minimumSegmentSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "conversionTimeoutSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sampleRateHz",
            "channels",
            "codec",
            "bitrateBps",
            "container",
            "fastStart"
          ],
          "properties": {
            "sampleRateHz": {
              "type": "integer",
              "minimum": 8000
            },
            "channels": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            },
            "codec": {
              "type": "string",
              "minLength": 1
            },
            "bitrateBps": {
              "type": "integer",
              "minimum": 8000
            },
            "container": {
              "type": "string",
              "minLength": 1
            },
            "fastStart": {
              "type": "boolean"
            }
          }
        },
        "asr": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "apiKeyEnv",
            "baseUrl",
            "model",
            "temporaryDirectoryPrefix",
            "instructions",
            "userPrompt"
          ],
          "properties": {
            "apiKeyEnv": {
              "$ref": "#/$defs/envName"
            },
            "baseUrl": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "temporaryDirectoryPrefix": {
              "type": "string",
              "minLength": 1
            },
            "instructions": {
              "type": "string",
              "minLength": 1
            },
            "userPrompt": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokenUsageTable",
        "timestampFormat"
      ],
      "properties": {
        "tokenUsageTable": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "timestampFormat": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "version",
        "transport",
        "host",
        "port",
        "path",
        "logLevel"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "transport": {
          "enum": [
            "streamable-http"
          ]
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "logLevel": {
          "$ref": "#/$defs/logLevel"
        },
        "imageModel": {
          "type": "object",
          "additionalProperties": false,
          "required": ["apiKeyEnv", "baseUrl", "model"],
          "properties": {
            "apiKeyEnv": { "type": "string", "minLength": 1 },
            "baseUrl": { "type": "string", "minLength": 1 },
            "model": { "type": "string", "minLength": 1 }
          }
        },
        "videoModel": {
          "type": "object",
          "additionalProperties": false,
          "required": ["apiKeyEnv", "baseUrl", "model"],
          "properties": {
            "apiKeyEnv": { "type": "string", "minLength": 1 },
            "baseUrl": { "type": "string", "minLength": 1 },
            "model": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "messages": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "required": [
        "steerImageUnsupported",
        "steerAccepted",
        "steerCompleted",
        "stopRequested",
        "stopIdle",
        "stopFailed",
        "recallStopped",
        "taskTimeout",
        "taskTimeoutUnconfirmed",
        "taskInterrupted",
        "newThreadCreated",
        "codexBusy",
        "invalidRequest",
        "unsupportedMethod",
        "codexFailure",
        "emptyInput",
        "missingResourceKeySuffix",
        "downloadFailedSuffix",
        "transcriptionFailedSuffix",
        "emptyTranscriptionSuffix",
        "newThreadFailed",
        "audioConversionTimeout",
        "unsupportedMessageType"
      ]
    }
  },
  "$defs": {
    "envName": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "logLevel": {
      "enum": [
        "CRITICAL",
        "ERROR",
        "WARNING",
        "INFO",
        "DEBUG",
        "NOTSET"
      ]
    },
    "messageTypes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "text",
          "image",
          "post",
          "file",
          "audio"
        ]
      }
    },
    "extensions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^\\.[a-z0-9]+$"
      }
    },
    "modelRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "provider"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
